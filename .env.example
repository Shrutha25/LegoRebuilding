# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Rebrickable REST API key (https://rebrickable.com/api/) - part images + BrickLink ID lookup
REBRICKABLE_API_KEY=

# Anthropic API key (https://console.anthropic.com/) - AI build ideas
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Thinking depth for ideas: low | medium | high. Leave empty for models without effort support.
LLM_EFFORT=medium

# Brickognize part recognition (no key needed)
BRICKOGNIZE_URL=https://api.brickognize.com/predict/parts/

# Minimum share of a set you must own to suggest it (0-1). 1.0 = only sets you can build completely.
MIN_COVERAGE=1.0
