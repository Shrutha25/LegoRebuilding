# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Rebrickable REST API key (https://rebrickable.com/api/) - part images + BrickLink ID lookup
REBRICKABLE_API_KEY=

# Google Gemini API key (https://aistudio.google.com/apikey) - AI build ideas
GEMINI_API_KEY=
# Fast model for ideas. Default: gemini-3.1-flash-lite (reliable, ~4 s). Larger Flash models such as
# gemini-3.8-flash give richer ideas but were overloaded (503/504) in testing. To see what your key
# can use: python -m backend.live_check --models
GEMINI_MODEL=gemini-3.1-flash-lite

# Brickognize part recognition (no key needed)
BRICKOGNIZE_URL=https://api.brickognize.com/predict/parts/

# Minimum share of a set you must own to suggest it (0-1). 1.0 = only sets you can build completely.
MIN_COVERAGE=1.0
