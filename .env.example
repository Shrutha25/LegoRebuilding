# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Rebrickable REST API key (https://rebrickable.com/api/) - part images + BrickLink ID lookup
REBRICKABLE_API_KEY=

# Google Gemini API key (https://aistudio.google.com/apikey) - AI build ideas
GEMINI_API_KEY=
# Fast model for ideas. Default: gemini-3.1-flash-lite (reliable, ~4 s). Larger Flash models such as
# gemini-3.8-flash give richer ideas but were overloaded (503/504) in testing. To see what your key
# can use: python -m backend.live_check --models
GEMINI_MODEL=gemini-3.1-flash-lite
# Model for the "Designed for your pile" concept call (streamed); defaults to GEMINI_MODEL.
# GEMINI_DESIGN_MODEL=
# Gemini calls per build-suggestions request: 1 = the concept call only (default); 3 adds one repair call and one batched look check.
# DESIGN_MAX_CALLS=1
# Thinking for text generation: minimal (default), low or none. Models that reject the level fall back to none.
# GEMINI_THINKING=minimal
# Recipes Gemini may write on demand per request (each can take several calls). 0 = never (default).
# RECIPE_GEN_PER_REQUEST=0

# Piece detection: opencv | gemini | hybrid. Default opencv until you have reviewed the evaluation
# (python -m backend.eval_detect); hybrid = Gemini boxes plus any OpenCV boxes Gemini missed.
# Gemini detection costs one API request per scan and falls back to OpenCV if it fails or takes > 20 s.
DETECTOR=opencv
# Model for detection (separate from GEMINI_MODEL above); the fallback is tried on 503/504.
GEMINI_DETECT_MODEL=gemini-3.1-flash-lite
GEMINI_DETECT_FALLBACK_MODEL=gemini-3.1-flash-lite

# Gemini quota budget: every Gemini request (detection and AI ideas) is counted per model in a SQLite file.
# The numbers are PLACEHOLDERS: check them against Google's current free-tier limits for your models.
# Builds (AI ideas) have priority: detection may use at most DETECTION_DAILY_SHARE of a model's daily limit
# and never the last BUILD_RESERVE requests; when the minute window is full detection is skipped at once
# (OpenCV is used) while a build waits up to BUILD_MAX_WAIT seconds. On HTTP 429 the model is paused.
GEMINI_RPM=10
GEMINI_RPD=20
# Per-model overrides, JSON: {"gemini-3.1-flash-lite": {"rpm": 15, "rpd": 500}}
GEMINI_MODEL_LIMITS=
DETECTION_DAILY_SHARE=0.3
# BUILD_RESERVE is a request count; leave empty to use BUILD_RESERVE_FRAC (a share of the daily limit)
BUILD_RESERVE=
BUILD_RESERVE_FRAC=0.2
GEMINI_RESET_TIME=00:00
GEMINI_RESET_TZ=America/Los_Angeles
BUILD_MAX_WAIT=10
# GEMINI_BUDGET_DB=rb_data/gemini_budget.sqlite

# Stud detection (OpenCV): on by default. STUDS_ENABLED=0 turns it off. DETECT_DEBUG_DIR=some/dir saves an overlay
# image per scan (studs, stud groups, boxes labelled by the method that found them).
STUDS_ENABLED=1
# Photos are taken at about 45 degrees, so studs look squashed: the photo is stretched by this factor vertically
# before looking for studs (1 = top-down photo).
STUD_TILT_STRETCH=1.5
# DETECT_DEBUG_DIR=

# 3D building instructions (LDraw). One-off: python -m backend.core.fetch_ldraw  (downloads the ~146 MB parts library zip).
# The viewer only ever receives the few files each model needs, packed into one .mpd and cached by build id.
# LDRAW_DIR=ldraw_data
# BUILD_CACHE_DIR=build_cache
# OMR_BASE_URL=https://library.ldraw.org/library/omr
# AI builds: at most this many parts; retry Gemini ONCE if more than this share of the parts had to be dropped; parts per step (1-3)
BUILD_MAX_PARTS=80
BUILD_MAX_DROP_FRACTION=0.2
BUILD_STEP_SIZE=3
# Recipe builds: Gemini only picks/names designs the code generated. AI_FREEFORM_BUILDS=1 also allows the old free-form placement as a
# fallback for /api/builds/recipes (default off). RECIPE_AI_TIMEOUT: seconds before standard names are used. RECIPE_SHOW: builds shown (3-5).
# RECIPE_GALLERY=1 enables the dev page /recipe-gallery.
AI_FREEFORM_BUILDS=0
RECIPE_AI_TIMEOUT=25
RECIPE_SHOW=5
RECIPE_GALLERY=0
# Frontend (frontend/.env.local): NEXT_PUBLIC_BUILD_ANIMATION=1 drops new parts into place in each step

# Brickognize part recognition (no key needed)
BRICKOGNIZE_URL=https://api.brickognize.com/predict/parts/

# Minimum share of a set you must own to suggest it (0-1). 1.0 = only sets you can build completely.
MIN_COVERAGE=1.0

# ---- which sets are matched, and where official LEGO instructions come from
# MIN_SET_PARTS=10                       sets with fewer parts are never matched
# EXCLUDED_THEMES=Gear,Key Chains,...    comma list, exact theme names (sub-themes included); defaults in backend/config.py
# EXCLUDED_THEME_WORDS=Gear,Key Chain,Magnet,Storage,Clothing,Video Games
# BRICKSET_API_KEY=                      free key from https://brickset.com/tools/webservices/requestkey ; without it sets without a 3D model show "not available online"
# INSTRUCTIONS_TTL_DAYS=7
# BRICKSET_DAILY_CAP=100                 Brickset calls per UTC day

# ---- concepts and on-demand recipes (backend/recipes)
# RECIPE_CONCEPTS=12             concepts asked from Gemini per request (10-15)
# RECIPE_LIBRARY_DIR=recipe_library
# RECIPE_GEN_PER_REQUEST=1       new recipes Gemini may write per request when too few concepts could be built (0 = never)
# RECIPE_GEN_TIMEOUT=90
# RECIPE_RECOGNISE=1             vision check "what is this model?" on generated recipes
