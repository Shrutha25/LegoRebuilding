{
  "id": "robot", "title": "Robot", "category": "robot", "tags": ["figure", "tall"],
  "nouns": ["robot", "bot", "droid", "android", "automaton", "mech", "golem"],
  "names": ["Tin Sentry", "Pocket Droid", "Gearheart", "Rusty Guard"],
  "roles": [{"name": "torso", "want": "major"}, {"name": "head", "want": "second"}, {"name": "arm", "want": "second"}, {"name": "leg", "want": "dark"}, {"name": "feet", "want": "neutral"}],
  "params": {"width": {"range": [4, 6], "bind": "w"}, "legs": {"range": [1, 2]}, "torso": {"range": [2, 3]}, "antenna": {"range": [0, 1]}},
  "silhouettes": {"tall-narrow": {"width": "lo", "legs": 2, "torso": 3, "antenna": 1}, "wide-squat": {"width": "hi", "legs": 1, "torso": 2, "antenna": 0},
                  "compact": {"width": "mid", "legs": 1, "torso": 3, "antenna": 1}, "long-low": {"width": "hi", "legs": 2, "torso": 2, "antenna": 0}},
  "requires": {"min_parts": 12, "min_long": 3, "min_area": 50},
  "derive": {"W": "width + 2"},
  "parts": [
    {"name": "feet", "primitive": "box", "role": "feet", "unit": "plate", "min_coverage": 0.8, "args": {"w": "W", "d": 2, "layers": 1}, "at": {"x": 0, "z": 0, "y": 0}},
    {"name": "leg", "primitive": "box", "role": "leg", "args": {"w": 2, "d": 2, "layers": "legs"}, "at": {"x": 1, "z": 0, "y": 1}, "mirror_x": "W"},
    {"name": "arm", "primitive": "box", "role": "arm", "args": {"w": 1, "d": 2, "layers": "legs + torso - 1"}, "at": {"x": 0, "z": 0, "y": 1}, "mirror_x": "W"},
    {"name": "torso", "primitive": "box", "role": "torso", "args": {"w": "width", "d": 2, "layers": "torso"}, "at": {"x": 1, "z": 0, "y": "1 + 3 * legs"}},
    {"name": "head", "primitive": "box", "role": "head", "args": {"w": "width - 2", "d": 2, "layers": 1}, "attach": {"to": "torso", "rel": "on_top_of", "anchor": "center"}},
    {"name": "antenna", "primitive": "box", "role": "head", "required": false, "when": "antenna == 1", "args": {"w": 1, "d": 1, "layers": 1},
     "attach": {"to": "head", "rel": "on_top_of", "anchor": "center"}}
  ],
  "symmetry": "x",
  "features": {"legs": ["leg"], "arms": ["arm"], "head": ["head"], "antenna": ["antenna"]}
}
