{
  "id": "castle", "title": "Castle gate", "category": "castle", "tags": ["building", "wall", "arch"],
  "nouns": ["castle", "gate", "gatehouse", "wall", "fort", "fortress", "citadel", "rampart", "barbican"],
  "names": ["Ironhold Gate", "Greywatch Wall", "Kingsford Gatehouse", "Little Bastion"],
  "roles": [{"name": "wall", "want": "major"}, {"name": "gate", "want": "second"}, {"name": "tower", "want": "second"}, {"name": "crest", "want": "neutral"}],
  "params": {"length": {"range": [8, 16], "bind": "w"}, "height": {"range": [2, 4], "bind": "h"}, "thick": {"range": [2, 3], "bind": "d"}, "span": {"range": [2, 4]}},
  "silhouettes": {"long-low": {"length": "hi", "height": "lo", "thick": 2, "span": 4}, "tall-narrow": {"length": "lo", "height": "hi", "thick": 3, "span": 2},
                  "wide-squat": {"length": "mid", "height": "mid", "thick": 3, "span": 3}, "arch": {"length": "mid", "height": "hi", "thick": 2, "span": 4}},
  "constraint": "length >= span + 6 and (length - span) % 2 == 0",
  "requires": {"min_parts": 14, "min_long": 4, "min_area": 60},
  "derive": {"gw": "span + 2", "sw": "(length - gw) // 2", "rw": "length - sw - gw"},
  "parts": [
    {"name": "plinth", "primitive": "box", "role": "wall", "unit": "plate", "min_coverage": 0.7, "args": {"w": "length", "d": "thick", "layers": 1}, "at": {"x": 0, "z": 0, "y": 0}},
    {"name": "wall-left", "primitive": "box", "role": "wall", "args": {"w": "sw", "d": "thick", "layers": "height"}, "at": {"x": 0, "z": 0, "y": 1}},
    {"name": "gate", "primitive": "arch", "role": "gate", "args": {"span": "span", "layers": "height", "leg_w": 1, "depth": "thick"}, "at": {"x": "sw", "z": 0, "y": 1}},
    {"name": "wall-right", "primitive": "box", "role": "wall", "args": {"w": "rw", "d": "thick", "layers": "height"}, "at": {"x": "sw + gw", "z": 0, "y": 1}},
    {"name": "tower", "primitive": "box", "role": "tower", "args": {"w": "thick", "d": "thick", "layers": 1}, "at": {"x": 0, "z": 0, "y": "1 + 3 * height"}, "mirror_x": "length"},
    {"name": "crenellation", "primitive": "checker", "role": "crest", "required": false, "kind": "cells",
     "args": {"w": "length - 2 * thick", "d": "thick", "layers": 1}, "at": {"x": "thick", "z": 0, "y": "1 + 3 * height"}}
  ],
  "symmetry": "x",
  "features": {"gate": ["gate"], "towers": ["tower"], "crenellations": ["crenellation"], "wall": ["wall-left", "wall-right"]}
}
