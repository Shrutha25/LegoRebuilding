{
  "id": "table", "title": "Table", "category": "furniture", "tags": ["furniture", "legs"],
  "nouns": ["table", "desk", "counter", "workbench", "bench", "stand"],
  "names": ["Round-Corner Table", "Workshop Bench", "Kitchen Table", "Tall Bar Counter"],
  "roles": [{"name": "top", "want": "major"}, {"name": "leg", "want": "dark"}, {"name": "item", "want": "second"}],
  "params": {"width": {"range": [3, 8], "bind": "w"}, "depth": {"range": [2, 5], "bind": "d"}, "leg": {"range": [1, 3], "bind": "h"}, "lamp": {"range": [0, 1]}},
  "silhouettes": {"long-low": {"width": "hi", "depth": "lo", "leg": 1, "lamp": 0}, "wide-squat": {"width": "mid", "depth": "hi", "leg": 1, "lamp": 1},
                  "tall-narrow": {"width": "lo", "depth": "lo", "leg": 3, "lamp": 1}, "compact": {"width": "lo", "depth": "mid", "leg": 2, "lamp": 0}},
  "requires": {"min_parts": 7, "min_long": 3, "min_area": 24, "min_build_parts": 5},
  "parts": [
    {"name": "legs", "primitive": "posts", "role": "leg", "args": {"x0": 0, "x1": "width - 1", "z0": 0, "z1": "depth - 1", "layers": "leg"}, "at": {"x": 0, "z": 0, "y": 0}},
    {"name": "top", "primitive": "box", "role": "top", "unit": "plate", "args": {"w": "width", "d": "depth", "layers": 2}, "at": {"x": 0, "z": 0, "y": "3 * leg"}},
    {"name": "lamp", "primitive": "box", "role": "item", "required": false, "when": "lamp == 1", "args": {"w": 1, "d": 1, "layers": 1},
     "attach": {"to": "top", "rel": "on_top_of", "anchor": "center"}}
  ],
  "symmetry": "xz",
  "features": {"legs": ["legs"], "top": ["top"]}
}
