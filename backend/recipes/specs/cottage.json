{
  "id": "cottage", "title": "Cottage", "category": "building", "tags": ["building", "house", "roof"],
  "nouns": ["cottage", "cabin", "chalet", "lodge", "bungalow", "farmhouse", "house", "hut"],
  "names": ["Thatch Cottage", "Brookside Cabin", "Fernhill Farmhouse", "Wren Cottage"],
  "roles": [{"name": "wall", "want": "major"}, {"name": "roof", "want": "second"}, {"name": "base", "want": "neutral"}, {"name": "chimney", "want": "dark"}],
  "params": {"width": {"range": [5, 8], "bind": "w"}, "depth": {"range": [4, 6], "bind": "d"}, "floors": {"range": [2, 3], "bind": "h"}},
  "silhouettes": {"wide-squat": {"width": "hi", "depth": "mid", "floors": "lo"}, "long-low": {"width": "hi", "depth": "lo", "floors": "lo"}, "compact": {"width": "lo", "depth": "lo", "floors": "hi"}},
  "constraint": "width >= depth + 1",
  "requires": {"min_parts": 16, "min_long": 4, "min_area": 60},
  "derive": {"top": "1 + 3 * floors", "dw": "2 if width >= 6 else 1", "doff": "(width - dw) // 2", "t": "1 if thin else 2"},
  "parts": [
    {"name": "base", "primitive": "box", "role": "base", "unit": "plate", "min_coverage": 0.85, "args": {"w": "width", "d": "depth", "layers": 1}, "at": {"x": 1, "z": 1, "y": 0}},
    {"name": "walls", "primitive": "wall_with_window", "role": "wall", "min_coverage": 0.85,
     "args": {"w": "width", "d": "depth", "layers": "floors", "thickness": "t", "door_w": "dw", "door_layers": 2, "door_off": "doff", "windows": 1, "window_layer": 1, "door_side": "front"},
     "at": {"x": 1, "z": 1, "y": 1}},
    {"name": "roof", "primitive": "slope_roof", "role": "roof", "unit": "plate", "min_coverage": 0.7, "args": {"w": "width + 2", "d": "depth + 2", "ridge": "x"}, "at": {"x": 0, "z": 0, "y": "top"}},
    {"name": "chimney", "primitive": "box", "role": "chimney", "required": false, "when": "not has_slopes", "args": {"w": 1, "d": 1, "layers": 1}, "at": {"x": 2, "z": 0, "y": "top + 1"}}
  ],
  "features": {"door": ["walls"], "windows": ["walls"], "roof": ["roof"], "chimney": ["chimney"]}
}
