{
  "id": "dog", "title": "Dog", "category": "animal", "tags": ["animal", "four-legged"],
  "nouns": ["dog", "puppy", "hound", "terrier", "pup", "fox", "wolf", "cat", "horse", "pony", "calf"],
  "names": ["Biscuit the Terrier", "Long Hound", "Patchwork Pup", "Mossy Pony"],
  "roles": [{"name": "body", "want": "major"}, {"name": "head", "want": "second"}, {"name": "leg", "want": "neutral"}, {"name": "tail", "want": "dark"}],
  "params": {"length": {"range": [4, 9], "bind": "d"}, "width": {"range": [2, 3], "bind": "w"}, "leg": {"range": [1, 3]}, "tail": {"range": [0, 1]}},
  "silhouettes": {"long-low": {"length": "hi", "width": "lo", "leg": 1, "tail": 1}, "compact": {"length": "lo", "width": "mid", "leg": 1, "tail": 1},
                  "tall-narrow": {"length": "mid", "width": "lo", "leg": 3, "tail": 0}, "wide-squat": {"length": "mid", "width": "hi", "leg": 1, "tail": 0}},
  "requires": {"min_parts": 10, "min_long": 3, "min_area": 30},
  "parts": [
    {"name": "legs", "primitive": "posts", "role": "leg", "args": {"x0": 0, "x1": "width - 1", "z0": 0, "z1": "length - 1", "layers": "leg"}, "at": {"x": 0, "z": 0, "y": 0}},
    {"name": "body", "primitive": "box", "role": "body", "args": {"w": "width", "d": "length", "layers": 1}, "at": {"x": 0, "z": 0, "y": "3 * leg"}},
    {"name": "head", "primitive": "head", "role": "head", "args": {"w": "width", "d": 2, "layers": 1, "ears": 1, "snout": 0},
     "attach": {"to": "body", "rel": "on_top_of", "anchor_x": "center", "anchor_z": "end", "dz": 1}},
    {"name": "tail", "primitive": "box", "role": "tail", "required": false, "when": "tail == 1", "args": {"w": 1, "d": 1, "layers": 1},
     "attach": {"to": "body", "rel": "on_top_of", "anchor_x": "center", "anchor_z": "start"}}
  ],
  "symmetry": "x",
  "features": {"legs": ["legs"], "head": ["head"], "tail": ["tail"], "ears": ["head"]}
}
