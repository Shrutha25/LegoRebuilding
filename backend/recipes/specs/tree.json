    {"name": "crown-top", "primitive": "cylinder", "role": "leaves", "required": false, "when": "crown >= 5", "args": {"diameter": "crown - 2", "layers": 1},
     "attach": {"to": "crown", "rel": "on_top_of", "anchor": "center"}}
  ],
  "features": {"trunk": ["trunk"], "crown": ["crown"]}
